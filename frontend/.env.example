# Copy to .env.local for local development:
#   Copy-Item .env.example .env.local   (Windows PowerShell)
#   cp .env.example .env.local          (macOS / Linux)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/live
# MediaPipe Tasks Vision model asset URLs (empty = landmark overlay disabled).
# Provide https URLs or /models/*.task paths once assets are hosted locally or remotely.
NEXT_PUBLIC_MEDIAPIPE_HAND_MODEL_URL=
NEXT_PUBLIC_MEDIAPIPE_POSE_MODEL_URL=
NEXT_PUBLIC_MEDIAPIPE_FACE_MODEL_URL=
